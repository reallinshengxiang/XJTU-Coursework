	cd /home/linshengxiang/Huawei-Software-Boot-Camp/项目练习_c++/executor_bootstrap-master/build && $(CMAKE_COMMAND) -P /home/linshengxiang/Huawei-Software-Boot-Camp/项目练习_c++/executor_bootstrap-master/build/CMakeFiles/VerifyGlobs.cmake
